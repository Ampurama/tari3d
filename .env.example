# Supabase project for "Main berdua" (playing together). Copy to .env.local and fill in.
# The publishable / anon key is meant to be public; never put the service_role or secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# or, with the legacy key:  VITE_SUPABASE_ANON_KEY=eyJ...
